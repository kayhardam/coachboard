---
// De tekst van de over-pagina in het Nederlands. Opmaak en stijl staan in
// src/pages/[lang]/about.astro; elke taal heeft hier een eigen bestand.
import { getRelativeLocaleUrl } from "astro:i18n";
import { boardPath } from "../../../data/nav";
import { contactEmail, owner } from "../../../data/site";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<p class="lead">Een gratis tactiekbord voor handbaltrainers, gemaakt door een handbaltrainer.</p>

<h2>Wat het doet</h2>
<ul>
  <li>
    Teken een aanval of verdediging op <a href={getRelativeLocaleUrl(lang, boardPath)}>het bord</a>,
    op een half of een heel veld.
  </li>
  <li>Sleep je spelers op hun plek en teken loopacties, passes en dribbels.</li>
  <li>
    Deel je tekening met je team, als link of QR-code. Je spelers zien hem op hun eigen telefoon,
    zonder app of account.
  </li>
  <li>
    Blader door de <a href={getRelativeLocaleUrl(lang, "tactics/")}>tactieken</a>. Open er een in
    het bord en pas die aan voor je team.
  </li>
</ul>

<h2>Gratis, zonder account</h2>
<p>
  Het bord is gratis. Jij en je spelers hebben geen account nodig. Er zijn geen cookies en geen
  advertenties. Op de <a href={getRelativeLocaleUrl(lang, "privacy/")}>privacypagina</a> lees je
  wat er met je tekeningen gebeurt.
</p>

<section id="contact">
  <h2>Contact</h2>
  <p>
    Handball Coachboard is gemaakt door {owner}. Een vraag of een idee?
    Mail naar <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</section>
