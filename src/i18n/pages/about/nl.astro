---
// De tekst van de over-pagina in het Nederlands. Opmaak en stijl staan in
// src/pages/[lang]/about.astro; elke taal heeft hier een eigen bestand.
import { getRelativeLocaleUrl } from "astro:i18n";
import { boardPath } from "../../../data/nav";
import { contactEmail, owner, ownerUrl } from "../../../data/site";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<p class="lead">Een tactiekbord voor handbaltrainers, gemaakt door een handbaltrainer.</p>

<h2>Wat het doet</h2>
<ul>
  <li>
    Teken een aanval, verdediging of oefening op <a href={getRelativeLocaleUrl(lang, boardPath)}>het bord</a>,
    op een half of een heel veld.
  </li>
  <li>Sleep je spelers op hun plek en teken loopacties, passes en dribbels.</li>
  <li>
    Deel je tekening met je team, als link of QR-code. Je spelers zien hem op hun eigen telefoon,
    zonder app of account.
  </li>
  <li>
    Blader door de <a href={getRelativeLocaleUrl(lang, "tactics/")}>tactieken</a> en <a
      href={getRelativeLocaleUrl(lang, "drills/")}>oefeningen</a>. Open er een in het bord en pas die
    aan voor je team.
  </li>
</ul>

<h2>Wat het bord kan</h2>
<ul>
  <li><strong>Pijlen tekenen.</strong> Het bord opent met Pijl aan: sleep vanaf een speler voor een loop en vanaf de bal voor een pass.</li>
  <li><strong>Soorten pijlen.</strong> Tik op een pijl en kies loop, pass, stuit, dribbel, schot of sper.</li>
  <li><strong>Schieten.</strong> Een pass die tussen de palen eindigt, is een schot.</li>
  <li><strong>Startopstellingen.</strong> Zet op een nieuw bord in één tik een opstelling neer: tegen 6-0, 5-1 of 3-2-1, of twee of drie rijen voor een oefening.</li>
  <li><strong>Stappen.</strong> Tik op Nieuwe stap voor de volgende stap en typ per stap één zin: wie doet wat.</li>
  <li><strong>Afspelen.</strong> Tik op de knop naast Nieuwe stap: de spelers bewegen langs hun pijlen, stap voor stap.</li>
  <li><strong>Mijn borden.</strong> In Meer staan je borden, bewaard in deze browser, in mappen in de volgorde van je training.</li>
  <li><strong>Delen.</strong> Alles staat in de link of in de QR-code uit Meer, dus je spelers zien elke stap met zijn zin, zonder account of app.</li>
</ul>

<h2>Gratis, zonder account</h2>
<p>
  Het bord is gratis. Jij en je spelers hebben geen account nodig. Er zijn geen cookies en geen
  advertenties. Op de <a href={getRelativeLocaleUrl(lang, "privacy/")}>privacypagina</a> lees je
  wat er met je tekeningen gebeurt.
</p>

<section id="contact">
  <h2>Contact</h2>
  <p>
    Handball Coachboard is gemaakt door <a href={ownerUrl}>{owner}</a>. Een vraag of een idee?
    Mail naar <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</section>
