---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultLocale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

// One 404 for the whole site, served by the host for any missing path.
const lang = defaultLocale;
---

<BaseLayout title={t(lang, "notFound.title")} description={t(lang, "notFound.description")} noindex>
  <section class="container">
    <h1>{t(lang, "notFound.heading")}</h1>
    <p>{t(lang, "notFound.body")}</p>
    <a class="btn btn-primary" href={getRelativeLocaleUrl(lang)}>{t(lang, "notFound.home")}</a>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: 80px;
    text-align: center;
  }

  h1 {
    margin-bottom: 12px;
    font-size: clamp(2rem, 5vw, 2.5rem);
  }

  p {
    margin-bottom: 24px;
    color: var(--color-text-muted);
  }
</style>
