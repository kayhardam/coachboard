---
import DrillFacts from "../../../components/DrillFacts.astro";
import LibraryItem from "../../../components/LibraryItem.astro";
import { itemPaths, type Item } from "../../../data/library";

export const getStaticPaths = () => itemPaths("drill");

interface Props {
  item: Item;
}

const { item } = Astro.props;
const { data } = item.entry;
---

<LibraryItem item={item}>
  {data.type === "drill" && <DrillFacts slot="setup" lang={item.lang} part="setup" drill={data} />}
  {data.type === "drill" && <DrillFacts slot="lists" lang={item.lang} part="lists" drill={data} />}
</LibraryItem>
