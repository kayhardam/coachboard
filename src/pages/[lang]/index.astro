---
import { getRelativeLocaleUrl } from "astro:i18n";
import CategoryCards from "../../components/CategoryCards.astro";
import Icon from "../../components/Icon.astro";
import Court from "../../components/board/Court.svelte";
import { boardPath } from "../../data/nav";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeParams } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { defaultBoardFor } from "../../lib/board/defaults";
import type { IconName } from "../../lib/icons";

export const getStaticPaths = localeParams;

const { lang } = Astro.params;
const boardHref = getRelativeLocaleUrl(lang, boardPath);
const steps: { icon: IconName; title: string; body: string }[] = [
  { icon: "draw", title: t(lang, "home.step1Title"), body: t(lang, "home.step1Body") },
  { icon: "link", title: t(lang, "home.step2Title"), body: t(lang, "home.step2Body") },
  { icon: "phone", title: t(lang, "home.step3Title"), body: t(lang, "home.step3Body") },
];
---

<BaseLayout title={t(lang, "home.title")} description={t(lang, "home.description")}>
  <section class="hero">
    <div class="container">
      <h1>{t(lang, "home.heading")}</h1>
      <p class="lead">{t(lang, "home.lead")}</p>
      <div class="actions">
        <a class="btn btn-primary" href={boardHref}>{t(lang, "cta.board")}</a>
        <a class="btn btn-secondary" href={getRelativeLocaleUrl(lang, "tactics/")}>{t(lang, "home.browse")}</a>
      </div>
      <p class="note">{t(lang, "home.note")}</p>
      <a class="preview" href={boardHref} tabindex="-1" aria-hidden="true">
        <Court board={defaultBoardFor(lang)} label={t(lang, "board.court")} />
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t(lang, "home.howTitle")}</h2>
      <p class="sub">{t(lang, "home.howLead")}</p>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="tile">
                <Icon name={step.icon} />
              </span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <h2>{t(lang, "home.libraryTitle")}</h2>
      <p class="sub">{t(lang, "home.libraryLead")}</p>
      <CategoryCards lang={lang} />
      <p class="more">
        <a href={getRelativeLocaleUrl(lang, "tactics/")}>{t(lang, "home.allTactics")}<Icon name="arrowRight" /></a>
      </p>
    </div>
  </section>

  <section class="section cta">
    <div class="container">
      <h2>{t(lang, "home.ctaTitle")}</h2>
      <p class="sub">{t(lang, "home.ctaBody")}</p>
      <a class="btn btn-primary" href={boardHref}>{t(lang, "cta.board")}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 56px 0 48px;
    background:
      radial-gradient(600px 300px at 80% 0%, rgb(22 163 74 / 0.12), transparent),
      var(--color-bg-soft);
    text-align: center;
  }

  h1 {
    max-width: 720px;
    margin: 0 auto 16px;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    max-width: 560px;
    margin: 0 auto 24px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .note {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .preview {
    display: block;
    max-width: 360px;
    margin: 24px auto 0;
    padding: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .section {
    padding: 56px 0;
  }

  .soft {
    background: var(--color-bg-soft);
    border-block: 1px solid var(--color-border);
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    text-align: center;
  }

  .sub {
    max-width: 560px;
    margin: 8px auto 32px;
    text-align: center;
    color: var(--color-text-muted);
  }

  .steps {
    display: grid;
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .tile {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    margin-bottom: 16px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: 19px;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1.125rem;
  }

  .steps p {
    color: var(--color-text-muted);
  }

  .more {
    margin-top: 24px;
    text-align: center;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    font-weight: 600;
  }

  .cta {
    text-align: center;
  }

  .cta .sub {
    margin-bottom: 24px;
  }

  @media (min-width: 860px) {
    .hero {
      padding: 80px 0 64px;
    }
    .lead {
      font-size: 1.25rem;
    }
    .section {
      padding: 72px 0;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
</style>
