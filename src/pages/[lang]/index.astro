---
import { getRelativeLocaleUrl } from "astro:i18n";
import Court from "../../components/board/Court.svelte";
import { boardPath } from "../../data/nav";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeParams } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { defaultBoard } from "../../lib/board/defaults";

export const getStaticPaths = localeParams;

const { lang } = Astro.params;
---

<BaseLayout title={t(lang, "home.title")} description={t(lang, "home.description")}>
  <section class="hero">
    <div class="container">
      <h1>{t(lang, "home.heading")}</h1>
      <p>{t(lang, "home.lead")}</p>
      <a class="btn btn-primary" href={getRelativeLocaleUrl(lang, boardPath)}>{t(lang, "cta.board")}</a>
      <p class="note">{t(lang, "home.note")}</p>
      <a class="preview" href={getRelativeLocaleUrl(lang, boardPath)} tabindex="-1" aria-hidden="true">
        <Court board={defaultBoard} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 56px 0 48px;
    background:
      radial-gradient(600px 300px at 80% 0%, rgb(22 163 74 / 0.12), transparent),
      var(--color-bg-soft);
    text-align: center;
  }

  h1 {
    max-width: 720px;
    margin: 0 auto 16px;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  p {
    max-width: 560px;
    margin: 0 auto 24px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .note {
    margin-top: 12px;
    font-size: 0.875rem;
  }

  .preview {
    display: block;
    max-width: 360px;
    margin: 8px auto 0;
    padding: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  @media (min-width: 860px) {
    .hero {
      padding: 80px 0 64px;
    }
    p {
      font-size: 1.25rem;
    }
  }
</style>
