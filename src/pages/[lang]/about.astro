---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeParams } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { pageText } from "../../i18n/pages";

export const getStaticPaths = localeParams;

const { lang } = Astro.params;
const Text = pageText(
  import.meta.glob<AstroComponentFactory>("../../i18n/pages/about/*.astro", { eager: true, import: "default" }),
  lang,
);
---

<BaseLayout title={t(lang, "about.title")} description={t(lang, "about.description")}>
  <article class="container">
    <h1>{t(lang, "about.heading")}</h1>
    <Text lang={lang} />
  </article>
</BaseLayout>

<style>
  /* The text comes from src/i18n/pages/; scoped styles reach it through :global(). */
  article {
    max-width: 720px;
    padding-block: 48px;
  }

  h1 {
    margin-bottom: 12px;
    font-size: clamp(2rem, 5vw, 2.5rem);
  }

  article :global(h2) {
    margin-top: 32px;
    margin-bottom: 8px;
    font-size: 1.25rem;
  }

  article :global(.lead) {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  article :global(ul) {
    display: grid;
    gap: 8px;
    padding-left: 24px;
  }

  article :global(#contact) {
    scroll-margin-top: 80px;
  }
</style>
