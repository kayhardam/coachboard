---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeParams } from "../../i18n/locales";
import { t } from "../../i18n/ui";
import { pageText } from "../../i18n/pages";

export const getStaticPaths = localeParams;

const { lang } = Astro.params;
const Text = pageText(
  import.meta.glob<AstroComponentFactory>("../../i18n/pages/privacy/*.astro", { eager: true, import: "default" }),
  lang,
);
---

<BaseLayout title={t(lang, "privacy.title")} description={t(lang, "privacy.description")}>
  <article class="container">
    <h1>{t(lang, "privacy.heading")}</h1>
    <Text />
  </article>
</BaseLayout>

<style>
  /* The text comes from src/i18n/pages/; scoped styles reach it through :global(). */
  article {
    max-width: 720px;
    padding-block: 48px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
  }

  article :global(h2) {
    margin-top: 32px;
    margin-bottom: 8px;
    font-size: 1.25rem;
  }

  article :global(.updated) {
    margin-bottom: 24px;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  article :global(.lead) {
    font-size: 1.125rem;
  }

  article :global(p + p) {
    margin-top: 12px;
  }

  article :global(code) {
    padding: 0 4px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
</style>
