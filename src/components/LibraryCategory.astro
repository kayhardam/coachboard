---
// The page of a category of a type (tactics/attack/, drills/attack/): its items,
// the other categories of that type and the way to the board.
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import LibraryCards from "./LibraryCards.astro";
import { categoryInfo, typeText, type Category } from "../data/categories";
import { boardPath } from "../data/nav";
import { categoryLanguages, type Item } from "../data/library";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import { typeDir, type ItemType } from "../lib/library";

interface Props {
  lang: string;
  category: Category;
  type: ItemType;
  items: Item[];
  others: Category[];
}

const { lang, category, type, items, others } = Astro.props;
const info = categoryInfo(lang, category, type);
const text = typeText(type);
const dir = typeDir(type);
---


<BaseLayout
  title={t(lang, text.categoryTitle, { label: info.label })}
  description={info.intro}
  languages={await categoryLanguages(type, category)}
>
  <div class="intro">
    <div class="container">
      <nav aria-label={t(lang, "tactic.breadcrumb")} class="crumbs">
        <a href={getRelativeLocaleUrl(lang, `${dir}/`)}>{t(lang, text.heading)}</a>
      </nav>
      <h1><span class="tile"><Icon name={info.icon} /></span>{info.label}</h1>
      <p>{info.intro}</p>
    </div>
  </div>

  <section class="container">
    <h2 class="visually-hidden">{t(lang, text.all)}</h2>
    <LibraryCards lang={lang} items={items} />

    {
      others.length > 0 && (
        <nav class="others" aria-labelledby="others">
          <h2 id="others">{t(lang, "category.others")}</h2>
          <ul>
            {others.map((c) => (
              <li>
                <a href={getRelativeLocaleUrl(lang, `${dir}/${c}/`)}>
                  <Icon name={categoryInfo(lang, c).icon} />
                  {categoryInfo(lang, c).label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </section>

  <section class="cta">
    <div class="container">
      <h2>{t(lang, text.cta)}</h2>
      <p>{t(lang, "category.ctaBody")}</p>
      <a class="btn btn-primary" href={getRelativeLocaleUrl(lang, boardPath)}>{t(lang, "cta.board")}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 24px 0 32px;
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: clamp(2rem, 6vw, 2.75rem);
  }

  .tile {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
    font-size: 19px;
  }

  .intro p {
    max-width: 680px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  section {
    margin-top: 32px;
  }

  .others {
    margin-top: 40px;
  }

  .others h2 {
    margin-bottom: 8px;
    font-size: 1.125rem;
  }

  .others ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    font-weight: 600;
  }

  .cta {
    margin-top: 56px;
    padding-block: 40px;
    background: var(--color-bg-soft);
    border-block: 1px solid var(--color-border);
    text-align: center;
  }

  .cta h2 {
    margin-bottom: 8px;
  }

  .cta p {
    margin-bottom: 20px;
    color: var(--color-text-muted);
  }
</style>
