---
// The page of a library item: the steps as a strip of drawings, each with its
// sentence, then the coaching points. tactics/[slug].astro renders it.
import { getRelativeLocaleUrl } from "astro:i18n";
import { render } from "astro:content";
import Icon from "./Icon.astro";
import LibraryCards from "./LibraryCards.astro";
import StepStrip from "./StepStrip.astro";
import { categoryInfo, itemMeta } from "../data/categories";
import { allItemsFor, itemLanguages, type Item } from "../data/library";
import { boardPath } from "../data/nav";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import { encode } from "../lib/board/format";
import { typeDir } from "../lib/library";

interface Props {
  item: Item;
}

const { item } = Astro.props;
const { lang, type } = item;
const { data } = item.entry;
const category = categoryInfo(lang, data.category);
const dir = typeDir(type);
const all = await allItemsFor(lang);
const related = data.related
  .map((r) => all.find((other) => other.entry.id === r.id))
  .filter((other): other is Item => other !== undefined);

// The link carries the drawing with its title and sentences, so the board
// (and a shared link from it) shows exactly this page's steps.
const boardHref = `${getRelativeLocaleUrl(lang, boardPath)}#t=${await encode({ ...data.board, title: data.title })}`;
const { Content } = await render(item.entry);
const hasBody = Boolean(item.entry.body?.trim());
---

<BaseLayout
  title={t(lang, "tactic.title", { title: data.title })}
  description={data.summary}
  image={`${getRelativeLocaleUrl(lang, item.path)}og.png`}
  languages={await itemLanguages(item.slug)}
>
  <article class="container">
    <nav aria-label={t(lang, "tactic.breadcrumb")} class="crumbs">
      <ol>
        <li><a href={getRelativeLocaleUrl(lang, `${dir}/`)}>{t(lang, "tactics.heading")}</a></li>
        <li><a href={getRelativeLocaleUrl(lang, `${dir}/${category.slug}/`)}>{category.label}</a></li>
      </ol>
    </nav>

    <header>
      <h1>{data.title}</h1>
      <p class="meta">{itemMeta(lang, data)}</p>
      <p class="lead">{data.summary}</p>
    </header>

    <div class="open">
      <a class="btn btn-primary" href={boardHref}>
        {t(lang, "tactic.open")}
        <Icon name="arrowRight" />
      </a>
      <p class="hint">{t(lang, "tactic.openHint")}</p>
    </div>

    <section>
      <h2>{t(lang, "tactic.steps")}</h2>
      <StepStrip lang={lang} board={data.board} />
    </section>

    {
      data.coachingPoints.length > 0 && (
        <section class="text">
          <h2>{t(lang, "tactic.coachingPoints")}</h2>
          <ul class="points">
            {data.coachingPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasBody && (
        <section class="text prose">
          <Content />
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <h2>{t(lang, "tactic.related")}</h2>
          <LibraryCards lang={lang} items={related} />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  article {
    padding-top: 8px;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    padding: 0;
    list-style: none;
  }
  .crumbs li + li::before {
    content: "/";
    content: "/" / "";
    margin: 0 8px;
    color: var(--color-text-muted);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  h1 {
    font-size: clamp(1.875rem, 6vw, 2.5rem);
  }

  .meta {
    margin-top: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent-dark);
  }

  .lead {
    max-width: 640px;
    margin-top: 12px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .open {
    display: grid;
    gap: 8px;
    justify-items: start;
    margin-top: 20px;
  }

  .btn {
    gap: 8px;
  }

  .hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  section {
    margin-top: 32px;
  }

  h2 {
    margin-bottom: 12px;
    font-size: 1.375rem;
  }

  .text {
    max-width: 720px;
  }

  .points {
    display: grid;
    gap: 12px;
    padding-left: 24px;
  }

  .prose :global(p + p) {
    margin-top: 12px;
  }

  .related {
    margin-top: 48px;
  }

  /* Print: an A4 page with the title, the steps and the coaching points.
     Text is 16 px (12 pt) already; only the smaller meta grows, grey turns
     black, and what only works on a screen is left out. */
  @media print {
    @page {
      size: A4;
      margin: 12mm;
    }

    :global(.skip-link),
    :global(.site-header),
    :global(.site-footer),
    .crumbs,
    .open,
    .related {
      display: none;
    }

    article {
      padding: 0;
    }

    .meta {
      font-size: 12pt;
    }

    .lead {
      color: #000;
    }

    h1 {
      font-size: 20pt;
    }

    h2 {
      break-after: avoid;
    }

    section {
      margin-top: 8mm;
    }
  }
</style>
