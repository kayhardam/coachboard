---
import { getRelativeLocaleUrl } from "astro:i18n";
import { footerOnly } from "../data/nav";
import { owner, ownerUrl } from "../data/site";
import { t } from "../i18n/ui";
import { defaultLocale, locales } from "../i18n/locales";

interface Props {
  /** The languages this page exists in; the others link to their home page. */
  languages: readonly string[];
}

const { languages: available } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
// The header's links (nav) stay out: the header sticks to the top of every page.
const siteLinks = footerOnly.map((item) => ({
  href: getRelativeLocaleUrl(locale, item.path) + (item.hash ? `#${item.hash}` : ""),
  label: t(locale, item.label),
}));

// "Made by {name}, handball coach": the name becomes the link to the owner's site.
const [madeBefore, madeAfter] = t(locale, "footer.madeBy").split("{name}");

// The same page in each other language, e.g. /en/privacy/ → /nl/privacy/.
const prefix = `/${locale}/`;
const rest = Astro.url.pathname.startsWith(prefix)
  ? Astro.url.pathname.slice(prefix.length)
  : "";
const languages = locales.map((code) => ({
  code,
  href: getRelativeLocaleUrl(code, available.includes(code) ? rest : ""),
  current: code === locale ? ("page" as const) : undefined,
}));
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div>
        <p class="brand">Coachboard</p>
        <p>{t(locale, "footer.tagline")}</p>
      </div>
      <div class="links">
        <nav aria-label={t(locale, "footer.site")}>
          <ul>
            {siteLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
        {
          languages.length > 1 && (
            <nav aria-label={t(locale, "footer.language")}>
              <ul class="languages">
                {languages.map((l) => (
                  <li>
                    <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current}>
                      {l.code.toUpperCase()}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </div>

    <div class="bottom">
      <p>{madeBefore}<a href={ownerUrl}>{owner}</a>{madeAfter}</p>
      <p>© {new Date().getFullYear()} Handball Coachboard</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    padding: 24px 0 8px;
    background: var(--color-primary);
    color: #cbd5e1;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 32px;
  }

  .brand {
    color: #fff;
    font-weight: 700;
  }

  /* Over, Contact, Privacy and EN NL: one row that wraps. */
  .links,
  ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 24px;
  }
  ul {
    list-style: none;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: #e2e8f0;
  }
  a:hover {
    color: #fff;
  }

  .languages {
    column-gap: 16px;
  }
  .languages a[aria-current="page"] {
    color: #fff;
    font-weight: 700;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: 24px;
    margin-top: 16px;
    padding-top: 8px;
    border-top: 1px solid var(--color-primary-soft);
    font-size: 0.875rem;
  }

  /* A link inside a sentence: not by colour alone. */
  .bottom a {
    text-decoration: underline;
  }

  @media (min-width: 560px) {
    .bottom {
      flex-wrap: nowrap;
    }
  }
</style>
