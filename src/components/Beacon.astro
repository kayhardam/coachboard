---
// Cloudflare Web Analytics: page views and Core Web Vitals, without cookies or
// storage. The beacon strips the query and the hash (#t=) from what it sends.
// Only the board pages load it; content pages ship no JS.
//
// - Last in <body> with defer: the editor loads through <astro-island> and a
//   dynamic import, which never wait for a deferred script.
// - "spa": false. Otherwise, in Chromium, the beacon counts every
//   history.replaceState() (each edit writes #t= to the address bar) as a page view.
// - The page's CSP must allow it: BoardPage.astro adds its script and endpoint
//   (here would be too late: <head> is already rendered).
import { analyticsToken, beaconSrc } from "../data/analytics";

const config = JSON.stringify({ token: analyticsToken, spa: false });
---

<script is:inline defer src={beaconSrc} data-cf-beacon={config}></script>
