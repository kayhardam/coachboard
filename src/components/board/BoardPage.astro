---
// The board page: the editor, its static fallback and the statistics beacon.
// /<lang>/board/ is the editor; /<lang>/board/link/ and /<lang>/board/qr/ are
// where shared links and QR codes point, so statistics can count them apart.
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { boardStrings, t } from "../../i18n/ui";
import { beaconEndpoint, beaconSrc } from "../../data/analytics";
import { defaultBoardFor } from "../../lib/board/defaults";
import { icons } from "../../lib/icons";
import { sharePaths } from "../../data/nav";
import Beacon from "../Beacon.astro";
import BoardEditor from "./BoardEditor.svelte";
// The editor's styles, linked on the board pages only (see the file).
import "./BoardEditor.css";
import Court from "./Court.svelte";

interface Props {
  /** The pages for shared boards: out of search results, like the 404. */
  noindex?: boolean;
}

const { noindex = false } = Astro.props;

// Only these pages may load the statistics beacon (Beacon.astro). This runs
// before BaseLayout writes the CSP <meta>; content pages keep the plain CSP.
// Astro.csp is undefined in `npm run dev`, which writes no CSP. A resource
// replaces Astro's default 'self', so 'self' (the editor's files) goes first.
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource(beaconSrc);
Astro.csp?.insertDirective(`connect-src 'self' ${beaconEndpoint}`);
const lang = Astro.currentLocale!;
const home = getRelativeLocaleUrl(lang);
const lineup = defaultBoardFor(lang);
const links = {
  link: getRelativeLocaleUrl(lang, sharePaths.link),
  qr: getRelativeLocaleUrl(lang, sharePaths.qr),
};
---

<BaseLayout title={t(lang, "board.title")} description={t(lang, "board.description")} {noindex} fullscreen>
  <h1 class="visually-hidden">{t(lang, "board.heading")}</h1>
  <BoardEditor client:only="svelte" strings={boardStrings(lang)} {home} {links} {lineup}>
    <div slot="fallback" class="fallback">
      <!-- The title bar's place, with its Home link: also the way back without JavaScript.
           Its placeholder is the same text as the editor's, so the page's largest
           text paints with the HTML instead of after the JS (LCP). -->
      <div class="titlebar">
        <a class="home" href={home} aria-label={t(lang, "board.home")} title={t(lang, "board.home")}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.court} /></svg>
        </a>
        <span class="title" aria-hidden="true">{t(lang, "board.addTitle")}</span>
      </div>
      <!-- The sentence's placeholder, as the editor shows it: larger than the title's, so it too must paint with the HTML (LCP). -->
      <span class="sentence" aria-hidden="true">{t(lang, "board.addText")}</span>
      <div class="court"><Court board={lineup} label={t(lang, "board.court")} /></div>
      <noscript><p>{t(lang, "board.noscript")}</p></noscript>
    </div>
  </BoardEditor>
  <slot />
  <Beacon />
</BaseLayout>

<style>
  /* The same box as BoardEditor's .editor, with the bars' space reserved, so
     the court doesn't move when the editor replaces this (finding 14 in
     docs/metingen.md; e2e/layout.spec.ts checks it). */
  .fallback {
    display: grid;
    /* Title bar, steps, sentence, court, tools. */
    grid-template-rows:
      minmax(var(--board-title), auto) var(--board-steps) var(--board-text) minmax(0, 1fr)
      minmax(var(--board-bar), auto);
    gap: var(--board-gap);
    width: 100%;
    min-height: 0;
    max-width: 720px;
    margin-inline: auto;
    padding: 0 8px max(8px, env(safe-area-inset-bottom));
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-inline: -8px;
    padding-inline: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  /* As the editor's empty title (BoardEditor.css), so it paints the same size. */
  .title {
    overflow: hidden;
    padding: 0 6px;
    color: var(--color-text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The brand mark, as in the editor's title bar. */
  .home {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
  }
  .home svg {
    width: 32px;
    height: 32px;
    padding: 6px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* As the editor's empty sentence (.line in BoardEditor.css), so it paints the same size. */
  .sentence {
    grid-row: 3;
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25;
  }

  /* Like the editor's stage: the court fits the space instead of sizing it. */
  .court {
    grid-row: 4;
    position: relative;
    min-height: 0;
  }
  .court > :global(svg) {
    position: absolute;
    inset: 0;
  }

  /* Wide: the title bar across, a column on each side of the court (see BoardEditor.css). */
  @media (min-width: 860px) and (min-height: 560px) {
    .fallback {
      grid-template: minmax(var(--board-title), auto) minmax(0, 1fr) / var(--board-wide-side) minmax(0, 1fr) var(--board-wide-steps);
      max-width: none;
      padding: 0 16px 16px;
      gap: 12px;
    }
    .titlebar {
      grid-column: 1 / -1;
      margin-inline: -16px;
      padding-inline: 16px;
    }
    .court {
      grid-area: 2 / 2;
    }
    /* In the list of steps on the right, beside the button of step 1. */
    .sentence {
      grid-area: 2 / 3;
      align-self: start;
      min-height: var(--tap);
      margin-left: calc(var(--tap) + 6px);
    }
    .fallback > :global(noscript) {
      grid-column: 1 / -1;
    }
  }

  /* The bars are panels at the sides, as on the board (see BoardEditor.css). */
  @media (orientation: landscape) and (max-height: 559px) {
    .fallback {
      /* The step bar's row below the court, as on the board. */
      grid-template: minmax(0, 1fr) var(--tap) / var(--board-tools) minmax(0, 1fr) var(--board-panel);
      max-width: none;
      padding: 4px 4px max(4px, env(safe-area-inset-bottom));
    }
    .titlebar {
      grid-area: 1 / 3;
      flex-direction: column;
      align-items: start;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .court {
      grid-area: 1 / 2;
    }
    /* At the bottom of the panel on the right, as on the board. */
    .sentence {
      grid-area: 1 / 3;
      align-self: end;
      min-height: var(--tap);
      padding: 4px 6px;
      font-size: 0.8125rem;
    }
    /* Only there without JavaScript, when no editor comes: below the court. */
    .fallback > :global(noscript) {
      grid-column: 1 / -1;
    }
  }

  p {
    padding: 8px;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
