---
// The overview of a type (tactics/, drills/): its categories, then all its items.
import CategoryCards from "./CategoryCards.astro";
import LibraryCards from "./LibraryCards.astro";
import { typeText } from "../data/categories";
import { itemsFor } from "../data/library";
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n/ui";
import type { ItemType } from "../lib/library";

interface Props {
  lang: string;
  type: ItemType;
}

const { lang, type } = Astro.props;
const text = typeText(type);
const items = await itemsFor(lang, type);
---


<BaseLayout title={t(lang, text.title)} description={t(lang, text.description)}>
  <div class="intro">
    <div class="container">
      <h1>{t(lang, text.heading)}</h1>
      <p>{t(lang, text.lead)}</p>
    </div>
  </div>

  <section class="container">
    <h2>{t(lang, "tactics.categories")}</h2>
    <CategoryCards lang={lang} type={type} />
  </section>

  <section class="container">
    <h2>{t(lang, text.all)}</h2>
    <LibraryCards lang={lang} items={items} />
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 40px 0 32px;
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    margin-bottom: 8px;
    font-size: clamp(2rem, 6vw, 2.75rem);
  }

  .intro p {
    max-width: 640px;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  section {
    margin-top: 40px;
  }

  h2 {
    margin-bottom: 16px;
    font-size: 1.5rem;
  }
</style>
