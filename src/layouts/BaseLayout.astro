---
import "../styles/tokens.css";
import "../styles/base.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { ogLocale } from "../i18n/ui";
import { defaultLocale, locales } from "../i18n/locales";

interface Props {
  title: string;
  description: string;
  /** Site-relative path to a 1200×630 PNG. Defaults to the language's og-default image. */
  image?: string;
  /**
   * The languages this page exists in, itself included; every language by default.
   * Translations share the path after the prefix (/en/privacy/ and /nl/privacy/).
   * They feed hreflang and the footer's language links.
   */
  languages?: readonly string[];
  /** Keep the page out of search results (404). Drops canonical and og:url too. */
  noindex?: boolean;
  /** An app page (the board): no site header or footer, and <main> fills the screen. The board has its own title bar. */
  fullscreen?: boolean;
}

const {
  title,
  description,
  image,
  languages = locales,
  noindex = false,
  fullscreen = false,
} = Astro.props;

const siteName = "Handball Coachboard";
const locale = Astro.currentLocale ?? defaultLocale;
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(Astro.url.pathname);
// The same page under each language's prefix. noindex pages (the 404, the
// pages for shared boards) get no hreflang.
const prefix = `/${locale}/`;
const rest = Astro.url.pathname.startsWith(prefix) ? Astro.url.pathname.slice(prefix.length) : "";
const translations = noindex ? [] : languages.map((code) => [code, `/${code}/${rest}`] as const);
// x-default is the English page, not /: the root redirects to /nl/.
const xDefault = translations.find(([code]) => code === defaultLocale)?.[1];
// scripts/og-default.mjs renders one per language; check-links fails on a missing one.
const ogImage = image ?? (locale === defaultLocale ? "/og-default.png" : `/og-default-${locale}.png`);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      translations.length > 1 &&
        translations.map(([hreflang, path]) => (
          <link rel="alternate" hreflang={hreflang} href={abs(path)} />
        ))
    }
    {
      translations.length > 1 && xDefault && (
        <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale[locale] ?? locale} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={{ fullscreen }}>
    {!fullscreen && <Header />}
    <main id="main">
      <slot />
    </main>
    {!fullscreen && <Footer {languages} />}
  </body>
</html>

<style>
  .fullscreen {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }

  /* One row and column that fill the screen, so the board sizes to the
     screen instead of to its own content. */
  .fullscreen main {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    flex: 1;
    min-height: 0;
  }
</style>
