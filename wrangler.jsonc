// Cloudflare Workers Builds runs `npx wrangler deploy` after `npm run build`
// on main, and `npx wrangler preview` on other branches.
// This file makes that a plain static-assets upload of dist/: no Worker code,
// no adapter. Without it, Wrangler reconfigures the project on every deploy.
{
  "name": "coachboard",
  // Keep this in the past: Cloudflare rejects a date newer than its runtime.
  // Nothing here depends on it; the Worker only serves files.
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /en/privacy → /en/privacy/, as trailingSlash: "always" expects.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html, with status 404, for anything that doesn't exist.
    "not_found_handling": "404-page"
  },
  // The production domain. It lives here, not only in the dashboard: a deploy
  // whose config lacks it removes it again. www redirects to it with a Redirect
  // Rule in the dashboard (a Custom Domain matches one exact hostname).
  "routes": [{ "pattern": "handballcoachboard.com", "custom_domain": true }],
  // coachboard.hardamkay.workers.dev stays up: links and QR codes shared before
  // the move point there. Also a preview URL per branch.
  "workers_dev": true,
  "preview_urls": true,
  // `wrangler preview` refuses to run without this block. It may stay empty:
  // it only holds preview-specific bindings and vars, and there are none.
  "previews": {}
}
