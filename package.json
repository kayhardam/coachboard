    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.3",
    "svelte": "^5.57.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
