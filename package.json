{
  "name": "coachboard",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build && node scripts/check-links.mjs && node scripts/check-budget.mjs",
    "budget": "node scripts/check-budget.mjs",
    "e2e": "playwright test",
    "import-link": "node scripts/import-link.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/svelte": "^9.1.6",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "svelte": "^5.59.1",
    "uqr": "^0.1.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
